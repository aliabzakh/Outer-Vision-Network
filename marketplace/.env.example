# Privy (embedded wallets): create an app at https://dashboard.privy.io, enable Solana embedded wallets
# and email login, and add http://localhost:5173 to Allowed origins. Only the App ID is needed.
VITE_PRIVY_APP_ID=
# Optional Privy client ID (App clients tab); leave empty to use the default client.
VITE_PRIVY_CLIENT_ID=

# Server
SOLANA_RPC=https://api.devnet.solana.com
VITE_SOLANA_RPC=https://api.devnet.solana.com
MARKET_KEYPAIR=.keys/marketplace.json
SONGS_DIR=../songs
PORT=8787
PUBLIC_URL=http://localhost:8787
